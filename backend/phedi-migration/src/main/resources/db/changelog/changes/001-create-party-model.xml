<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-01" author="akrasovski">
        <comment>FASE 1: Criar tabela party (entidade base do Party Model)</comment>

        <createTable tableName="party">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="public_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="party_type" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="deleted_at" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
        </createTable>

        <createIndex indexName="idx_party_type" tableName="party">
            <column name="party_type" />
        </createIndex>

        <sql> ALTER TABLE party ADD CONSTRAINT chk_party_type CHECK (party_type IN ('PERSON',
            'ORGANIZATION')) </sql>
    </changeSet>

    <changeSet id="001-02" author="akrasovski">
        <comment>FASE 1: Criar tabela person (pessoa física)</comment>

        <createTable tableName="person">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                    foreignKeyName="fk_person_party"
                    references="party(id)" />
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="middle_name" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="full_name" type="VARCHAR(300)">
                <constraints nullable="false" />
            </column>
            <column name="date_of_birth" type="DATE">
                <constraints nullable="true" />
            </column>
            <column name="gender" type="VARCHAR(20)">
                <constraints nullable="true" />
            </column>
        </createTable>

        <sql> ALTER TABLE person ADD CONSTRAINT chk_person_gender CHECK (gender IN ('MALE',
            'FEMALE', 'OTHER', 'PREFER_NOT_TO_SAY')) </sql>

    </changeSet>

    <changeSet id="001-03" author="akrasovski">
        <comment>FASE 1: Criar tabela organization (pessoa jurídica)</comment>

        <createTable tableName="organization">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                    foreignKeyName="fk_organization_party"
                    references="party(id)" />
            </column>
            <column name="legal_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="trade_name" type="VARCHAR(255)">
                <constraints nullable="true" />
            </column>
            <column name="brand_name" type="VARCHAR(255)">
                <constraints nullable="true" />
            </column>
            <column name="founding_date" type="DATE">
                <constraints nullable="true" />
            </column>
        </createTable>

    </changeSet>

    <changeSet id="001-04" author="akrasovski">
        <comment>
            FASE 1: Criar sequence para public_id.
            Sequence compartilhada: gera os identificadores
            públicos de party e de todas as suas tabelas filhas
            (party_contact, party_address, ...).
        </comment>

        <createSequence
            sequenceName="party_public_id_seq"
            startValue="1000000"
            incrementBy="1"
            minValue="1000000"
            maxValue="99999999"
            cycle="false" />
    </changeSet>


    <changeSet id="001-05" author="akrasovski">

        <comment>
            FASE 1: Criar tabela de documentos de identificação do Party.
            Um Party pode possuir múltiplos documentos, como CPF, CNPJ,
            RG, Passaporte, Inscrição Estadual, VAT, etc.
        </comment>

        <createTable tableName="party_identity_document">

            <!-- Identificador técnico da persistência -->
            <column name="id"
                type="BIGINT"
                autoIncrement="true">
                <constraints
                    primaryKey="true"
                    primaryKeyName="party_identity_document_pkey"
                    nullable="false" />
            </column>

            <!--
                Identificador público do documento.
                Gerado por party_public_id_seq, a mesma sequence
                usada por todas as tabelas do Party.
            -->
            <column name="public_id"
                type="VARCHAR(36)">
                <constraints nullable="false" unique="true" />
            </column>

            <!-- Party ao qual o documento pertence -->
            <column name="party_id"
                type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_party_identity_document_party"
                    referencedTableName="party"
                    referencedColumnNames="id" />
            </column>

            <!--
                Tipo do documento.
                Exemplos: CPF, CNPJ, RG, PASSPORT,
                STATE_TAX_REGISTRATION, VAT, etc.
            -->
            <column name="document_type"
                type="VARCHAR(30)">
                <constraints nullable="false" />
            </column>

            <!-- Número/valor do documento -->
            <column name="document_number"
                type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>

            <!--
                Código ISO 3166-1 alpha-2 do país relacionado ao documento.
                Exemplos: BR, US, AR.
            -->
            <column name="country_code"
                type="VARCHAR(2)" />

            <!--
                Região/estado relacionado à emissão do documento.
                Útil principalmente para documentos cuja numeração
                depende da jurisdição, como inscrições estaduais.
            -->
            <column name="issuer_region"
                type="VARCHAR(10)" />

            <!-- Órgão ou autoridade responsável pela emissão -->
            <column name="issuing_authority"
                type="VARCHAR(100)" />

            <!-- Data de emissão do documento -->
            <column name="issued_at"
                type="DATE" />

            <!-- Data de expiração, quando aplicável -->
            <column name="expires_at"
                type="DATE" />

            <!-- Indica se este é o documento principal do Party -->
            <column name="is_primary"
                type="BOOLEAN"
                defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>

            <!--
                Indica se o documento está atualmente ativo.
                Diferente de deleted_at: um documento pode ser inativo
                sem necessariamente ter sido removido do histórico.
            -->
            <column name="is_active"
                type="BOOLEAN"
                defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>

            <!-- Data de criação do registro -->
            <column name="created_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!-- Data da última atualização -->
            <column name="updated_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!--
                Data da exclusão lógica.
                NULL indica que o registro não foi excluído logicamente.
            -->
            <column name="deleted_at"
                type="TIMESTAMP" />

        </createTable>

        <!--
            Permite localizar rapidamente todos os documentos
            pertencentes a um Party.
        -->
        <createIndex
            indexName="idx_party_identity_document_party"
            tableName="party_identity_document">

            <column name="party_id" />

        </createIndex>

        <!--
            Índice para consultas por documento.
            O country_code participa da busca para suportar
            documentos internacionais.
        -->
        <createIndex
            indexName="idx_party_identity_document_lookup"
            tableName="party_identity_document">

            <column name="country_code" />
            <column name="document_type" />
            <column name="document_number" />

        </createIndex>

        <!--
            Permite filtrar documentos pelo tipo.
            Exemplo: localizar todos os CNPJs cadastrados.
        -->
        <createIndex
            indexName="idx_party_identity_document_type"
            tableName="party_identity_document">

            <column name="document_type" />

        </createIndex>

        <!--
            Permite consultas de documentos ativos.
        -->
        <createIndex
            indexName="idx_party_identity_document_active"
            tableName="party_identity_document">

            <column name="is_active" />

        </createIndex>

    </changeSet>


    <changeSet id="001-06" author="akrasovski">

        <comment>
            FASE 1: Criar tabela de contatos do Party.
            Um Party pode possuir múltiplas formas de contato,
            como e-mail, telefone, celular, WhatsApp, etc.
        </comment>

        <createTable tableName="party_contact">

            <!-- Identificador técnico da persistência -->
            <column name="id"
                type="BIGINT"
                autoIncrement="true">
                <constraints
                    primaryKey="true"
                    primaryKeyName="party_contact_pkey"
                    nullable="false" />
            </column>

            <!--
                Identificador público do contato.
                Gerado por party_public_id_seq, a mesma sequence
                usada por todas as tabelas do Party.
            -->
            <column name="public_id"
                type="VARCHAR(36)">
                <constraints nullable="false" unique="true" />
            </column>

            <!-- Party ao qual o contato pertence -->
            <column name="party_id"
                type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_party_contact_party"
                    referencedTableName="party"
                    referencedColumnNames="id" />
            </column>

            <!--
                Canal de contato.
                Exemplos: EMAIL, PHONE, MOBILE,
                LANDLINE, WHATSAPP, FAX, WEBSITE, OTHER.
            -->
            <column name="contact_type"
                type="VARCHAR(30)">
                <constraints nullable="false" />
            </column>

            <!--
                Finalidade/contexto do contato.
                Exemplos: PERSONAL, COMMERCIAL,
                BILLING, SUPPORT, OTHER.
                NULL significa que não há finalidade declarada.
            -->
            <column name="purpose"
                type="VARCHAR(20)">
                <constraints nullable="true" />
            </column>

            <!--
                Valor do contato.
                Exemplos: contato@empresa.com, +55 11 99999-9999.
            -->
            <column name="contact_value"
                type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>

            <!--
                Código ISO 3166-1 alpha-2 do país do contato.
                Relevante para telefones com DDI.
                Exemplos: BR, US, AR.
            -->
            <column name="country_code"
                type="VARCHAR(2)">
                <constraints nullable="true" />
            </column>

            <!-- Indica se este é o contato principal do Party -->
            <column name="is_primary"
                type="BOOLEAN"
                defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>

            <!--
                Indica se o contato está atualmente ativo.
                Diferente de deleted_at: um contato pode estar
                inativo sem ter sido removido logicamente.
            -->
            <column name="is_active"
                type="BOOLEAN"
                defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>

            <!-- Data de criação do registro -->
            <column name="created_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!-- Data da última atualização -->
            <column name="updated_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!--
                Data da exclusão lógica.
                NULL indica que o registro não foi excluído logicamente.
            -->
            <column name="deleted_at"
                type="TIMESTAMP" />

        </createTable>

        <!--
            Permite localizar rapidamente todos os contatos
            pertencentes a um Party.
        -->
        <createIndex
            indexName="idx_party_contact_party"
            tableName="party_contact">

            <column name="party_id" />

        </createIndex>

        <!--
            Permite filtrar contatos pelo canal.
            Exemplo: todos os contatos por e-mail.
        -->
        <createIndex
            indexName="idx_party_contact_type"
            tableName="party_contact">

            <column name="contact_type" />

        </createIndex>

        <!--
            Índice para busca por valor do contato,
            composto com o tipo para consultas diretas
            (ex.: localizar o PHONE de um contato).
        -->
        <createIndex
            indexName="idx_party_contact_lookup"
            tableName="party_contact">

            <column name="contact_type" />
            <column name="contact_value" />

        </createIndex>

        <!-- Impede contatos duplicados para o mesmo Party -->
        <addUniqueConstraint
            constraintName="uq_party_contact_value"
            tableName="party_contact"
            columnNames="party_id, contact_type, contact_value" />

        <sql> ALTER TABLE party_contact ADD CONSTRAINT chk_party_contact_type
            CHECK (contact_type IN ('EMAIL',
            'PHONE', 'MOBILE', 'LANDLINE', 'WHATSAPP', 'FAX', 'WEBSITE', 'OTHER')) </sql>

        <sql> ALTER TABLE party_contact ADD CONSTRAINT chk_party_contact_purpose
            CHECK (purpose IS NULL OR purpose IN ('PERSONAL',
            'COMMERCIAL', 'BILLING', 'SUPPORT', 'OTHER')) </sql>

    </changeSet>


    <changeSet id="001-07" author="akrasovski">

        <comment>
            FASE 1: Criar tabela de endereços do Party.
            Um Party pode possuir múltiplos endereços,
            como residencial, comercial, cobrança, entrega, etc.
        </comment>

        <createTable tableName="party_address">

            <!-- Identificador técnico da persistência -->
            <column name="id"
                type="BIGINT"
                autoIncrement="true">
                <constraints
                    primaryKey="true"
                    primaryKeyName="party_address_pkey"
                    nullable="false" />
            </column>

            <!--
                Identificador público do endereço.
                Gerado por party_public_id_seq, a mesma sequence
                usada por todas as tabelas do Party.
            -->
            <column name="public_id"
                type="VARCHAR(36)">
                <constraints nullable="false" unique="true" />
            </column>

            <!-- Party ao qual o endereço pertence -->
            <column name="party_id"
                type="BIGINT">
                <constraints
                    nullable="false"
                    foreignKeyName="fk_party_address_party"
                    referencedTableName="party"
                    referencedColumnNames="id" />
            </column>

            <!--
                Tipo de endereço.
                Exemplos: RESIDENTIAL, COMMERCIAL,
                BILLING, SHIPPING, CORRESPONDENCE, OTHER.
            -->
            <column name="address_type"
                type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>

            <!--
                Apelido/opcional para identificar o endereço.
                Exemplos: Casa, Escritório matriz, CAIXA postal.
            -->
            <column name="label"
                type="VARCHAR(50)">
                <constraints nullable="true" />
            </column>

            <!-- Logradouro (rua, avenida, travessa, ...) -->
            <column name="street"
                type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>

            <!--
                Número.
                NULL para endereços cuja jurisdição não usa numeração.
            -->
            <column name="number"
                type="VARCHAR(20)">
                <constraints nullable="true" />
            </column>

            <!-- Complemento (apartamento, sala, bloco, ...) -->
            <column name="complement"
                type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>

            <!-- Bairro/district -->
            <column name="district"
                type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>

            <!-- Cidade -->
            <column name="city"
                type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>

            <!--
                Estado, província ou região.
                Exemplos: SP, CA, Ontario.
            -->
            <column name="state_region"
                type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>

            <!--
                Código postal (CEP, ZIP, ...).
                NULL para países sem código postal.
            -->
            <column name="postal_code"
                type="VARCHAR(20)">
                <constraints nullable="true" />
            </column>

            <!--
                Código ISO 3166-1 alpha-2 do país.
                Exemplos: BR, US, AR.
            -->
            <column name="country_code"
                type="VARCHAR(2)">
                <constraints nullable="false" />
            </column>

            <!-- Indica se este é o endereço principal do Party -->
            <column name="is_primary"
                type="BOOLEAN"
                defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>

            <!--
                Indica se o endereço está atualmente ativo.
                Diferente de deleted_at: um endereço pode estar
                inativo sem ter sido removido logicamente.
            -->
            <column name="is_active"
                type="BOOLEAN"
                defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>

            <!-- Data de criação do registro -->
            <column name="created_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!-- Data da última atualização -->
            <column name="updated_at"
                type="TIMESTAMP"
                defaultValueDate="now()">
                <constraints nullable="false" />
            </column>

            <!--
                Data da exclusão lógica.
                NULL indica que o registro não foi excluído logicamente.
            -->
            <column name="deleted_at"
                type="TIMESTAMP" />

        </createTable>

        <!--
            Permite localizar rapidamente todos os endereços
            pertencentes a um Party.
        -->
        <createIndex
            indexName="idx_party_address_party"
            tableName="party_address">

            <column name="party_id" />

        </createIndex>

        <!--
            Permite filtrar endereços pelo tipo.
            Exemplo: todos os endereços de cobrança.
        -->
        <createIndex
            indexName="idx_party_address_type"
            tableName="party_address">

            <column name="address_type" />

        </createIndex>

        <!-- Índice para buscas por código postal -->
        <createIndex
            indexName="idx_party_address_postal"
            tableName="party_address">

            <column name="postal_code" />

        </createIndex>

        <sql> ALTER TABLE party_address ADD CONSTRAINT chk_party_address_type
            CHECK (address_type IN ('RESIDENTIAL',
            'COMMERCIAL', 'BILLING', 'SHIPPING', 'CORRESPONDENCE', 'OTHER')) </sql>

    </changeSet>


</databaseChangeLog>
