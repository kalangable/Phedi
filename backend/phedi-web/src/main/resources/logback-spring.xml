<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Configuracao de log baseada nos defaults do Spring Boot 4.

        Mantem o formato padrao (colors, nivel, PID, nome da aplicacao via %esb) e
        adiciona o requestId do MDC (populado pelo RequestIdFilter) apos a thread.
        Fora de uma requisicao (ex.: startup) aparece "[-]".
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- %esb(){APPLICATION_NAME}%esb{APPLICATION_GROUP}[%15.15t] [%X{requestId:--}] ${LOG_CORRELATION_PATTERN:-}){faint}%clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>